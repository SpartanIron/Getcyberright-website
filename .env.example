# =============================================================
# .env.example — Copy to .env and fill in your values
# NEVER commit your actual .env file to version control
# =============================================================

# ---- Server ----
NODE_ENV=development
PORT=8080

# ---- Database ----
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Authentication ----
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# ---- Admin ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-here

# ---- Email (Resend) ----
RESEND_API_KEY=re_your_key_here
EMAIL_FROM_ADDRESS=noreply@getcyberright.com
EMAIL_FROM_NAME=GetCyberRight

# ---- AI / LLM ----
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=sk-your-key-here

# ---- Security / Threat Intel ----
GOOGLE_SAFE_BROWSING_API_KEY=your-key-here
VIRUSTOTAL_API_KEY=your-key-here
URLHAUS_AUTH_KEY=your-key-here
RECAPTCHA_SECRET_KEY=your-key-here
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-key-here

# ---- Social / Marketing ----
BUFFER_API_KEY=your-key-here
BUFFER_ORG_ID=your-org-id-here
FACEBOOK_APP_ID=your-app-id-here
LINKEDIN_CLIENT_ID=your-client-id-here
THREADS_APP_ID=your-app-id-here

# ---- Analytics ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Google AdSense ----
# Publisher ID (used by both the loader script and the meta verification tag).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4503226092429202
# Per-placement slot IDs. Leave blank until you create the ad units in AdSense.
# When blank, the corresponding <AdSlot /> renders nothing (no requests, no markup).
NEXT_PUBLIC_ADSENSE_SLOT_NEWS_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MULTIPLEX=
NEXT_PUBLIC_ADSENSE_SLOT_SCAMS_INLINE=
