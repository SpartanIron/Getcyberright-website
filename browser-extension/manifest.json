{
  "manifest_version": 3,
  "name": "GCR Scam Guard by GetCyberRight",
  "version": "1.4.0",
  "description": "AI-powered scam & phishing protection by GetCyberRight LLC (getcyberright.com). Scans pages using VirusTotal, PhishTank, and Google Safe Browsing. Detects fake sites, warns before phishing attacks, and blocks notification spam. Built by ColorCode Solutions.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.getcyberright.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/core.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/scanner.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}