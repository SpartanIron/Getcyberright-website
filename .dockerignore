# Build artifacts and caches
.next/
node_modules/
.cache/
tmp/
/tmp/

# Development and tooling
.local/
# NOTE: artifacts/ is intentionally NOT ignored. Railpack detects
# artifacts/mockup-sandbox/package.json in the repo and the Railway build fails
# with "not found" if it is excluded from the build context.
.git/
.agents/
.playwright/
test-results/
coverage/
.vscode/
.idea/

# Test files
**/*.test.*
**/*.spec.*
**/__tests__/

# Logs
*.log
npm-debug.log*

# Temp and swap files
*.swp
*.swo
*~
